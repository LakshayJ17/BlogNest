# Copy to .env. These values are bundled into the public JavaScript, so never
# put secrets here.

# Backend URL. Defaults to http://localhost:8787 in dev and the Render URL in production.
# VITE_BACKEND_URL=http://localhost:8787

# Google OAuth client ID. Must match GOOGLE_CLIENT_ID in backend/.env.
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key for the bot check on signup and sign-in.
# Pairs with TURNSTILE_SECRET_KEY in backend/.env. Leave empty to hide the check.
VITE_TURNSTILE_SITE_KEY=

