# Copy this file to .env and fill in the values. Never commit .env.

# --- Required -------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/blognest"

# Secret for signing login tokens. Use a long random value, e.g.:
#   openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=""

# --- Google sign-in -------------------------------------------------------

# Must be the same client ID as VITE_GOOGLE_CLIENT_ID in the frontend.
# The server verifies Google tokens with it. Without it, Google sign-in is off.
GOOGLE_CLIENT_ID=""

# --- Bot check on signup and sign-in (Cloudflare Turnstile) ---------------

# Secret key from https://dash.cloudflare.com/?to=/:account/turnstile
# Pair it with VITE_TURNSTILE_SITE_KEY in the frontend, and set that one first:
# once this is set, signup and sign-in are refused without a valid check.
# Leave empty to turn the check off (fine for local development).
TURNSTILE_SECRET_KEY=""

# --- AI features (pick ONE provider) -------------------------------------
# Used for "write with AI", article summaries, and the content check that
# runs before a post is published. With no key set, AI features are off and
# posts publish without a content check.

# Free: https://console.groq.com/keys (default model openai/gpt-oss-120b)
GROQ_API_KEY=""

# Free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=""

# Free models: https://openrouter.ai/keys
# OPENROUTER_API_KEY=""

# Paid: https://platform.openai.com/api-keys
# OPENAI_API_KEY=""

# Optional overrides:
# AI_PROVIDER=groq            # groq | gemini | openrouter | openai | custom
# AI_MODEL=                   # model for writing and summaries
# AI_MODERATION_MODEL=        # model for the pre-publish content check
# AI_MODERATION=off           # skip the content check entirely
# AI_MODERATION_MAX_CHARS=16000  # how much of a post the content check reads.
#                             # Longer posts are checked at the start and end.
#                             # Raise on a paid AI plan to check all of long posts.
#
# Any OpenAI-compatible server, e.g. a local Ollama:
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=

# --- Optional -------------------------------------------------------------

# PORT=8787
# JWT_EXPIRES_IN=7d
# Comma-separated list of frontend origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173,https://blognest.bylakshayjain.online
# Number of proxies in front of the server (1 for Render). Lets rate limiting
# see real visitor IPs.
# TRUST_PROXY=1
